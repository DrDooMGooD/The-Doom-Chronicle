# ─────────────────────────────────────────────────────────────────────────────
# The Doom Chronicle — Environment Variables Reference
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API

# Server-side only (used by api-server.ts — never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # ⚠ Bypasses RLS — keep secret!

# Browser-safe (anon key — limited by RLS, safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Admin CMS ─────────────────────────────────────────────────────────────────
# Server-side only (checked via x-admin-passphrase header — never prefix with VITE_)
ADMIN_PASSPHRASE=

# ── Cloudflare Turnstile CAPTCHA ──────────────────────────────────────────────
# From: https://dash.cloudflare.com → Turnstile → Add Widget
# DEV TEST KEYS (always pass — safe to use during development):
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=        # Server-side secret (never VITE_ prefix)
VITE_TURNSTILE_SITE_KEY=     # Browser-safe site key

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://thedoomchronicle.net
API_PORT=3001

# ── Integrations (optional) ───────────────────────────────────────────────────
VITE_FORMSPREE_FORM_ID=
API_AGENT_KEY=
